# Web
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI - zero-cost reference configuration.
# Gemini is the default for chat and 1536-d retrieval embeddings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=1536
DAILY_MESSAGE_LIMIT=200
MAX_RAG_CHUNKS=10

# Paid providers are disabled unless explicitly opted into.
ALLOW_BILLABLE_AI=false
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
AI_MODEL=
OPENAI_MODEL=

# Worker / GitHub Actions
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WORKER_POLL_SECONDS=3
WORKER_BATCH_SIZE=4
WORKER_ONESHOT=true
MAX_SOURCE_BYTES=52428800

# Malware scanning. GitHub Actions runs an official ClamAV service container.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
MALWARE_SCAN_REQUIRED=true
