# Web
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI - Vercel deployments can use automatically refreshed VERCEL_OIDC_TOKEN.
# AI_GATEWAY_API_KEY is an optional static-key alternative for Gateway use outside Vercel.
AI_GATEWAY_API_KEY=
VERCEL_OIDC_TOKEN=
OPENAI_API_KEY=
# Set these to model IDs currently supported by your provider / AI Gateway.
AI_MODEL=
OPENAI_MODEL=
EMBEDDING_MODEL=openai/text-embedding-3-small
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
DAILY_MESSAGE_LIMIT=200
MAX_RAG_CHUNKS=10

# Worker - runs outside Vercel, so it currently requires direct OpenAI credentials for embeddings.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
WORKER_POLL_SECONDS=3
WORKER_BATCH_SIZE=2
MAX_SOURCE_BYTES=52428800

# Malware scanning - recommended REQUIRED in production.
CLAMAV_HOST=
CLAMAV_PORT=3310
MALWARE_SCAN_REQUIRED=false
